APP_NAME=CalcRating
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://calcrating.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/calcrating/shared/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

TRUSTED_PROXIES=*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@calcrating.example.com"
MAIL_FROM_NAME="${APP_NAME}"

BACKUP_PATH=/var/www/calcrating/shared/backups
BACKUP_RETENTION_DAYS=14

VITE_APP_NAME="${APP_NAME}"
